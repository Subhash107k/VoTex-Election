# =========================================================================
# VoTex Enterprise Application Environment Variables Template
# =========================================================================

# -----------------
# 1. CORE APPLICATION CONFIGURATION
# -----------------
NODE_ENV="development"
PORT="3000"

# APP_URL: The URL where this app is hosted.
APP_URL="YOUR_APP_URL"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# -----------------
# 2. SECURITY & JWT (Authentication)
# -----------------
# JWT_SECRET: Security token for signing & verifying session payloads.
JWT_SECRET="YOUR_VOTEX_JWT_SECRET_KEY"

# JWT_REFRESH_SECRET: Long-lived secret key to sign and issue replacement tokens.
JWT_REFRESH_SECRET="YOUR_VOTEX_JWT_REFRESH_SECRET"

# BALLOT_ENCRYPTION_SECRET: Server-side secret used to encrypt ballot choices.
BALLOT_ENCRYPTION_SECRET="YOUR_BALLOT_ENCRYPTION_SECRET"

# VOTE_HMAC_SECRET: Server-side secret used to sign ballot integrity hashes.
VOTE_HMAC_SECRET="YOUR_VOTE_HMAC_SECRET"

# BACKUP_ENCRYPTION_SECRET: Server-side secret used to encrypt local fallback backup archives.
BACKUP_ENCRYPTION_SECRET="YOUR_BACKUP_ENCRYPTION_SECRET"

# -----------------
# 3. DURABLE DATABASE INTEGRATION
# -----------------
# MONGODB_URI: Full connection string URI for MongoDB instance.
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/votex_db?retryWrites=true&w=majority"

# -----------------
# 4. EMAIL TRANSMISSION CONTROLS (SMTP)
# -----------------
# SMTP_HOST: Outgoing mail server address (e.g. smtp.gmail.com, mail.privateemail.com)
SMTP_HOST="smtp.example.com"

# SMTP_PORT: Dynamic socket port used for SMTP connections (e.g., 587 for TLS, 465 for SSL)
SMTP_PORT="587"

# SMTP_USER: Mailbox account name or auth credential
SMTP_USER="notifications@votex-system.example.com"

# SMTP_PASS: Mailbox account passkey or application-specific access token
SMTP_PASS="YOUR_SMTP_SECURE_PASSWORD"

# SMTP_FROM: Sender identity visible on incoming mail receipts
SMTP_FROM='"VoTex Certified Alerts" <noreply@votex-system.example.com>'

# -----------------
# 5. BIOMETRICS & SMS TELEPHONY GATEWAY (Twilio)
# -----------------
# TWILIO_ACCOUNT_SID: Unique developer account identifier for Twilio API controls
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# TWILIO_AUTH_TOKEN: Secret communication credential for secure REST actions
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"

# TWILIO_PHONE_NUMBER: Virtual voice/SMS phone number allocated to your account
TWILIO_PHONE_NUMBER="+15550001234"
